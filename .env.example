# Copy to .env and fill in. Never commit .env.
# Leave PayPal keys empty (or set MOCK_MODE=1) to run fully offline against the in-memory fake.

# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- LLM brain: openai | gemini (leave empty to use the deterministic intent parser)
LLM_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model override (defaults: gpt-4o-mini / gemini-2.5-flash)
LLM_MODEL=

# --- App
# 1 = force mock PayPal + rule-based parser even if keys are set
MOCK_MODE=0
# Where the buyer's browser returns after PayPal checkout
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_CURRENCY=USD
# Safety cap: the agent refuses any single amount above this
MAX_AMOUNT=10000
BRAND_NAME=AgentPay Demo Store
